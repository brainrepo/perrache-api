{
  "name": "@perrache/api",
  "version": "0.1.0",
  "private": true,
  "description": "Perrache API - Fastify backend server",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/env": "^5.0.3",
    "@fastify/helmet": "^13.0.2",
    "@fastify/swagger": "^9.6.0",
    "@fastify/swagger-ui": "^5.2.3",
    "@perrache/types": "workspace:*",
    "@prisma/client": "^6.19.0",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^6.1.0",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "prisma": "^6.19.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@perrache/config": "workspace:*",
    "@types/node": "^20.11.0",
    "@vitest/ui": "^4.0.8",
    "dotenv": "^17.2.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.8"
  }
}
