# Database Configuration
# PostgreSQL with pgvector extension for vector similarity search
# Note: connection_limit will be automatically appended to the URL based on DB_POOL_SIZE
DATABASE_URL="postgresql://perrache:perrache_dev_password@localhost:5432/perrache?schema=public"

# Database Connection Pool Size (optional, defaults to 10)
# This value is automatically added as 'connection_limit' parameter to the DATABASE_URL
# You can also specify connection_limit directly in DATABASE_URL to override this setting
DB_POOL_SIZE=10

# API Catalog Multi-Environment Support
# The API Catalog schema stores API versions per environment using a flexible string field (per ADR-009)
# This supports enterprise deployment patterns with custom environment names:
# - Standard: dev, staging, prod, qa
# - Custom: canary, preview, feature-branch-123, blue, green, etc.
# The environment field accepts any string value to accommodate diverse deployment strategies

# Rate Limiting
# Maximum requests per hour per API key
RATE_LIMIT_MAX=100

# Logging Configuration
# Available levels: trace, debug, info, warn, error, fatal
# Default: "info" for production, "debug" recommended for development
LOG_LEVEL=info

# Security Configuration
# Server-side secret for HMAC-SHA-256 API key hashing
# IMPORTANT: Generate a strong random secret (minimum 32 characters recommended)
# Example: openssl rand -hex 32
API_KEY_SECRET=your-secret-key-here-change-in-production