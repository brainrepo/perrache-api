# Docker Compose Environment Variables
# Copy this file to .env for local development with Docker

# Node Environment
NODE_ENV=production

# Database Configuration
DB_USER=perrache
DB_PASSWORD=perrache_dev
DB_NAME=perrache
DB_PORT=5432

# API Configuration
API_PORT=3001
LOG_LEVEL=info

# Web Configuration
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Security Configuration
# Server-side secret for HMAC-SHA-256 API key hashing
# IMPORTANT: Generate a strong random secret (minimum 32 characters recommended)
# Example: openssl rand -hex 32
API_KEY_SECRET=your-secret-key-here-change-in-production
